{
  "name": "briskine",
  "version": "8.0.2",
  "description": "Write everything faster.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:vendor": "test/scripts/vendor-test-deps.sh",
    "setup": "firebase login",
    "start": "vite build --watch --mode development",
    "start:firefox:android": "web-ext run --source-dir ./ext/ -t firefox-android",
    "staging": "vite build --watch --mode staging",
    "build": "npm run build:chrome && npm run build:firefox && npm run build:safari",
    "build:chrome": "BROWSER=chrome vite build --mode production",
    "build:firefox": "BROWSER=firefox vite build --mode production",
    "build:safari": "BROWSER=safari vite build --mode production",
    "sourcebuild": "git archive --format zip --output sourcebuild/sourcebuild-${npm_package_version}.zip HEAD; zip -u sourcebuild/sourcebuild-${npm_package_version}.zip .firebase-config-production.json",
    "lint": "eslint",
    "lint:firefox": "npm run build:firefox && web-ext lint --source-dir ./ext",
    "playwright:firefox": "npm run build:firefox && playwright test --project=firefox",
    "playwright:chrome": "npm run build:chrome && playwright test --project=chromium",
    "playwright:run": "npm run playwright:firefox && npm run playwright:chrome",
    "release": "npm run lint && npm test && npm run playwright:run && npm run sourcebuild"
  },
  "repository": "https://github.com/briskine/briskine/",
  "author": "Alexandru Plugaru <alex@gorgias.com>",
  "contributors": [
    {
      "name": "Ionut Colceriu",
      "email": "contact@ghinda.net"
    },
    {
      "name": "Alex Bumbu",
      "email": "bmbalex@gmail.com"
    },
    {
      "name": "Martin Latrille",
      "email": "martin@gorgias.com"
    },
    {
      "name": "Hadrien de Lamotte",
      "email": "hadrien.lamotte@gmail.com"
    },
    {
      "name": "Ovidiu Colceriu",
      "email": "ovidiu@briskine.com"
    }
  ],
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@playwright/test": "^1.42.1",
    "@stylistic/eslint-plugin": "^5.0.0",
    "@types/node": "^26.0.0",
    "@vitest/browser-playwright": "^4.0.17",
    "archiver": "^8.0.0",
    "dotenv": "^17.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-solid": "^0.17.0",
    "firebase-tools": "^15.0.0",
    "glob": "^13.0.0",
    "globals": "^17.0.0",
    "http-server": "^14.1.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.47.0",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14",
    "vite-plugin-solid-svg": "^0.8.1",
    "vitest": "^4.0.17",
    "web-ext": "^10.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@webcomponents/custom-elements": "^1.4.3",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.10.3",
    "es-toolkit": "^1.50.0",
    "firebase": "^12.0.0",
    "fuse.js": "^7.0.0",
    "html-to-text": "^10.0.0",
    "moment": "^2.29.1",
    "mousetrap": "github:briskine/mousetrap#master",
    "solid-js": "^1.8.18",
    "webextension-polyfill": "^0.12.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "protobufjs@7.6.4": true,
    "re2@1.25.0": true
  }
}
